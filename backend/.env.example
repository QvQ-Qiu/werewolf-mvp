# Coze Integration（推荐，狼人杀 AI 默认）
COZE_INTEGRATION_API_KEY=
COZE_INTEGRATION_BASE_URL=https://integration.coze.cn/api/v3
COZE_INTEGRATION_MODEL=doubao-seed-2-0-mini-260215

# 火山方舟（备用）
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=doubao-seed-2-0-mini-260215

# 本地 vLLM（可选；设置 LLM_BASE_URL 后会优先于云厂商 Key）
# LLM_BASE_URL=http://127.0.0.1:8001/v1
# LLM_API_KEY=not-needed
# LLM_MODEL=Qwen/Qwen3.5-9B

# 通义千问 / DashScope（备用）
QWEN_API_KEY=
# DASHSCOPE_API_KEY=
QWEN_MODEL=qwen-turbo
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

LLM_TIMEOUT_SECONDS=60
LLM_SPEECH_MAX_CHARS=350

# 夜晚 AI 加速（默认开启）
LLM_NIGHT_FAST_MODE=true
LLM_NIGHT_MAX_TOKENS=128
LLM_VOTE_FAST_MODE=true
LLM_VOTE_MAX_TOKENS=128

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

GAME_SPEECH_MAX_SECONDS=60
GAME_NIGHT_ACTION_TIMEOUT_SECONDS=30
CORS_ORIGINS=http://localhost:5173
